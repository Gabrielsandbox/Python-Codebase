# Publicação dos snapshots. Vazio = disco local em data/latest (desenvolvimento).
APURACAO_S3_BUCKET=
APURACAO_S3_PREFIX=
APURACAO_S3_ENDPOINT=            # ex.: https://<account_id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto

# Diretórios (opcional)
APURACAO_DATA_DIR=data/latest
APURACAO_WEB_DIR=web/public

# Acervo (fase 2): chaves de API separadas por vírgula, até existir banco + billing
APURACAO_API_KEYS=
