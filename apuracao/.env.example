# Publicação dos snapshots. Vazio = disco local em data/latest (desenvolvimento).
APURACAO_S3_BUCKET=
APURACAO_S3_PREFIX=
APURACAO_S3_ENDPOINT=            # ex.: https://<account_id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto

# Diretórios (opcional)
APURACAO_DATA_DIR=data/latest
APURACAO_WEB_DIR=web/public

# Acervo (fase 2): chaves de API separadas por vírgula, até existir banco + billing
APURACAO_API_KEYS=

# Chat ao vivo (R$ 5). CHAT_PAGAMENTO=dev não cobra (só desenvolvimento).
CHAT_PAGAMENTO=dev
CHAT_PRECO_CENTAVOS=500
CHAT_JWT_SECRET=                 # obrigatório fora do dev: 32+ caracteres aleatórios
CHAT_DB=data/chat.sqlite
CHAT_REDIS_URL=                  # redis://host:6379/0 para rodar mais de um processo
CHAT_DADOS_BASE=http://127.0.0.1:8000/dados
CHAT_CORS=*                      # em produção: https://apuracaoaovivo.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Conta (quem paga fica logado; login por link no e-mail). Sem RESEND_API_KEY o link só vai para o log.
RESEND_API_KEY=                   # https://resend.com → API Keys (domínio apuracaoaovivo.com verificado)
EMAIL_DE=Apuração ao Vivo <contato@apuracaoaovivo.com>
CHAT_JWT_DIAS=365                 # duração da sessão
ESPERA_CHAVE=                     # chave para baixar a lista de espera: GET https://chat.<dominio>/espera.csv?chave=…
GOOGLE_CLIENT_ID=                 # Entrar com Google: OAuth client id (tipo Web) do Google Cloud; o mesmo vai em VITE_GOOGLE_CLIENT_ID no site

# Alertas (Web Push + Telegram). Gere as chaves com: python -m alertas gerar-vapid
APURACAO_SITE_URL=https://apuracaoaovivo.com/
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:contato@seu-dominio.com.br
TELEGRAM_BOT_TOKEN=               # do @BotFather
TELEGRAM_BOT_NOME=                # ex.: ApuracaoBot (sem @)
TELEGRAM_POLLING=1                # 0 em produção com webhook em /alertas/telegram/webhook
ALERTAS_DEV=1                     # 0 em produção (desliga POST /alertas/teste)

TELEGRAM_CANAL=                   # @seu_canal público: 1 post por marco, alcance ilimitado (recomendado)
ALERTAS_PUSH_CONCORRENCIA=64
