# Lido automaticamente pelo `vite build` (modo production). Não são segredos.
# Em desenvolvimento (`vite`) nada disso vale: o proxy local serve /dados, /chat e /alertas.
VITE_DADOS_BASE=https://dados.apuracaoaovivo.com
VITE_CHAT_BASE=https://chat.apuracaoaovivo.com/chat
VITE_ALERTAS_BASE=https://alertas.apuracaoaovivo.com/alertas
VITE_API_BASE=https://api.apuracaoaovivo.com/api
VITE_GOOGLE_CLIENT_ID=
# 1 = página de espera na raiz e app em /ao-vivo; apague ou ponha 0 para lançar
VITE_ESPERA=1
# token do Cloudflare Web Analytics (Analytics & Logs → Web Analytics → Add site); vazio = desligado
VITE_CF_BEACON=
