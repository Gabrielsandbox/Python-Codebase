// Deploy do site como Worker com arquivos estáticos (Workers & Pages → Connect to Git).
// Build: npm ci && npm run build   Deploy: npx wrangler deploy   Root directory: apuracao/web
// Só assets, sem código de Worker: as requisições de arquivos estáticos não contam na cota.
// `public/_headers` vai para dist/ e vale aqui também (cache por caminho).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apuracaoaovivo",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
